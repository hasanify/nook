{
  "id": "ai-book-nugget",
  "name": "Book Nugget",
  "description": "Extracts one actionable mental model or framework from non-fiction books",
  "version": "1.0.0",
  "author": "Nook",
  "defaultSize": { "w": 300, "h": 250 },
  "minSize": { "w": 260, "h": 210 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "book",
      "label": "Favorite Book (optional)",
      "type": "text",
      "placeholder": "Leave empty for curated rotations"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "text",
      "placeholder": "gpt-4o-mini",
      "defaultValue": "gpt-4o-mini"
    },
    {
      "key": "endpoint",
      "label": "Custom API Endpoint",
      "type": "text",
      "placeholder": "https://api.openai.com/v1"
    },
    {
      "key": "apiKey",
      "label": "API Key Override",
      "type": "text",
      "placeholder": "Optional widget-specific key"
    }
  ]
}
