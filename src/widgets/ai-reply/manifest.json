{
  "id": "ai-reply",
  "name": "Quick Reply",
  "description": "Generate 3 one-click contextual replies to any incoming message",
  "version": "1.0.0",
  "author": "Nook",
  "defaultSize": { "w": 300, "h": 260 },
  "minSize": { "w": 260, "h": 220 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "model",
      "label": "Model",
      "type": "text",
      "placeholder": "gpt-4o-mini",
      "defaultValue": "gpt-4o-mini"
    },
    {
      "key": "endpoint",
      "label": "Custom API Endpoint",
      "type": "text",
      "placeholder": "https://api.openai.com/v1"
    },
    {
      "key": "apiKey",
      "label": "API Key Override",
      "type": "text",
      "placeholder": "Optional widget-specific key"
    }
  ]
}
