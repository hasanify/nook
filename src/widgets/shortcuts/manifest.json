{
  "id": "shortcuts",
  "name": "Desktop Shortcuts",
  "description": "Quick launch apps, folders, and web bookmarks with one click",
  "version": "1.1.0",
  "author": "Nook",
  "defaultSize": { "w": 280, "h": 240 },
  "minSize": { "w": 200, "h": 140 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "layout",
      "label": "Layout Style",
      "type": "select",
      "defaultValue": "grid",
      "options": [
        { "label": "App Tiles (Grid)", "value": "grid" },
        { "label": "Compact Rows (List)", "value": "list" }
      ]
    },
    {
      "key": "columns",
      "label": "Grid Columns",
      "type": "select",
      "defaultValue": "2",
      "options": [
        { "label": "2 Columns", "value": "2" },
        { "label": "3 Columns", "value": "3" },
        { "label": "4 Columns", "value": "4" }
      ]
    },
    {
      "key": "showLabels",
      "label": "Show Labels",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "showSubtitles",
      "label": "Show Subtitle / URL",
      "type": "boolean",
      "defaultValue": true
    }
  ]
}
