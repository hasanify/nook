{
  "id": "notes",
  "name": "Notes",
  "description": "Quick scratchpad with auto-saving text",
  "version": "1.0.0",
  "author": "Nook",
  "defaultSize": { "w": 280, "h": 240 },
  "minSize": { "w": 200, "h": 160 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "fontSize",
      "label": "Font Size",
      "type": "select",
      "defaultValue": "13",
      "options": [
        { "label": "11 px", "value": "11" },
        { "label": "12 px", "value": "12" },
        { "label": "13 px (Default)", "value": "13" },
        { "label": "14 px", "value": "14" },
        { "label": "15 px", "value": "15" },
        { "label": "16 px", "value": "16" },
        { "label": "18 px", "value": "18" },
        { "label": "20 px", "value": "20" }
      ]
    },
    {
      "key": "lineWrapping",
      "label": "Wrap Lines",
      "type": "boolean",
      "defaultValue": true
    }
  ]
}
