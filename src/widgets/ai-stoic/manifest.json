{
  "id": "ai-stoic",
  "name": "Stoic Pause",
  "description": "Daily ancient philosophical reflection paired with a behavioral micro-action",
  "version": "1.0.0",
  "author": "Nook",
  "defaultSize": { "w": 290, "h": 230 },
  "minSize": { "w": 250, "h": 190 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "philosopher",
      "label": "Preferred Philosopher (optional)",
      "type": "text",
      "placeholder": "Marcus Aurelius, Seneca, Epictetus"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "text",
      "placeholder": "gpt-4o-mini",
      "defaultValue": "gpt-4o-mini"
    },
    {
      "key": "endpoint",
      "label": "Custom API Endpoint",
      "type": "text",
      "placeholder": "https://api.openai.com/v1"
    },
    {
      "key": "apiKey",
      "label": "API Key Override",
      "type": "text",
      "placeholder": "Optional widget-specific key"
    }
  ]
}
