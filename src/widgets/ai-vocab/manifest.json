{
  "id": "ai-vocab",
  "name": "Daily Vocab",
  "description": "Expressive words and cultural slang with phonetic spelling and conversational context",
  "version": "1.0.0",
  "author": "Nook",
  "defaultSize": { "w": 290, "h": 230 },
  "minSize": { "w": 250, "h": 190 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "flavor",
      "label": "Vocabulary Flavor",
      "type": "select",
      "defaultValue": "all",
      "options": [
        { "label": "Balanced & Eclectic", "value": "all" },
        { "label": "Sophisticated & Literary", "value": "literary" },
        { "label": "Modern & Cultural Slang", "value": "slang" },
        { "label": "Untranslatable Foreign Gems", "value": "untranslatable" }
      ]
    },
    {
      "key": "model",
      "label": "Model",
      "type": "text",
      "placeholder": "gpt-4o-mini",
      "defaultValue": "gpt-4o-mini"
    },
    {
      "key": "endpoint",
      "label": "Custom API Endpoint",
      "type": "text",
      "placeholder": "https://api.openai.com/v1"
    },
    {
      "key": "apiKey",
      "label": "API Key Override",
      "type": "text",
      "placeholder": "Optional widget-specific key"
    }
  ]
}
