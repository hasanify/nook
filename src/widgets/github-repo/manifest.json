{
  "id": "github-repo",
  "name": "GitHub Repo",
  "description": "Recent commits, workflow runs, stars, forks, and release status",
  "version": "1.2.0",
  "author": "Nook",
  "defaultSize": { "w": 320, "h": 270 },
  "minSize": { "w": 260, "h": 200 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "repository",
      "label": "Repository (owner/repo)",
      "type": "text",
      "placeholder": "facebook/react",
      "defaultValue": ""
    },
    {
      "key": "branch",
      "label": "Branch",
      "type": "text",
      "placeholder": "main",
      "defaultValue": "main"
    },
    {
      "key": "showStars",
      "label": "Show Stars",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "showForks",
      "label": "Show Forks",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "showIssues",
      "label": "Show Open Issues",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "showRelease",
      "label": "Show Latest Release",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "showRuns",
      "label": "Show Workflow Runs",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "showCommits",
      "label": "Show Recent Commits",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "commitCount",
      "label": "Recent Commits Count",
      "type": "select",
      "defaultValue": 5,
      "options": [
        { "label": "3 commits", "value": 3 },
        { "label": "5 commits (Default)", "value": 5 },
        { "label": "10 commits", "value": 10 },
        { "label": "15 commits", "value": 15 }
      ]
    },
    {
      "key": "pollInterval",
      "label": "Auto-Refresh Interval",
      "type": "select",
      "defaultValue": 0,
      "options": [
        { "label": "Manual only (Recommended)", "value": 0 },
        { "label": "Every 5 minutes", "value": 300 },
        { "label": "Every 15 minutes", "value": 900 },
        { "label": "Every 30 minutes", "value": 1800 },
        { "label": "Every 1 hour", "value": 3600 }
      ]
    }
  ]
}
