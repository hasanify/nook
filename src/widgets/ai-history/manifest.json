{
  "id": "ai-history",
  "name": "Today in History",
  "description": "Pivotal event on today's calendar date and its modern impact",
  "version": "1.0.0",
  "author": "Nook",
  "defaultSize": { "w": 290, "h": 240 },
  "minSize": { "w": 250, "h": 200 },
  "resizable": true,
  "settingsSchema": [
    {
      "key": "model",
      "label": "Model",
      "type": "text",
      "placeholder": "gpt-4o-mini",
      "defaultValue": "gpt-4o-mini"
    },
    {
      "key": "endpoint",
      "label": "Custom API Endpoint",
      "type": "text",
      "placeholder": "https://api.openai.com/v1"
    },
    {
      "key": "apiKey",
      "label": "API Key Override",
      "type": "text",
      "placeholder": "Optional widget-specific key"
    }
  ]
}
